{
  "contract_version": 2,
  "product_name": "nddev-qwen-code-app",
  "github_repository": "NDDev-it-com/nddev-qwen-code-app",
  "license": "AGPL-3.0-or-later",
  "manifest_ref": "build/manifest.json",
  "version_ref": "build/version.json",
  "managed_state": {
    "stamp_file": "NDDEV-QWEN-CODE-SETUP.json",
    "stamp_schema": 2,
    "legacy_stamp_schema": {
      "schema_version": 1,
      "readable_setup_ids": ["safe", "full-auto"],
      "migration_required_setup_ids": ["balanced"]
    },
    "managed_file_mode": "0600",
    "managed_files": ["settings.json", "QWEN.md", "AGENTS.md", ".claude/CLAUDE.md"],
    "managed_tree_root": "extensions/nddev-builder",
    "preserve_other_state": true
  },
  "setup_system": {
    "catalog_root": "setups",
    "identity_source": "setups/<setup-id>/setup.json",
    "setup_ids": ["nddev-builder"],
    "profile_root": "profiles",
    "profile_ids": ["full-auto", "safe"],
    "default_profile": "full-auto",
    "legacy_setup_ids": ["safe", "balanced", "full-auto"],
    "selection_option": "--setup nddev-builder --profile <full-auto|safe>",
    "list_command": "python3 cli-tools/nddev_qwen_code.py list [--json]",
    "status_command": "python3 cli-tools/nddev_qwen_code.py status --target <absolute-target> [--json]",
    "launch_command": "python3 cli-tools/nddev_qwen_code.py launch --target <absolute-target> [--workspace <absolute-project-dir>] -- [args...]",
    "builder_status_command": "python3 cli-tools/nddev_qwen_code.py builder-status --target <absolute-target> [--json]",
    "builder_default_on": true
  },
  "safety": {
    "explicit_target_required": true,
    "absolute_target_required": true,
    "relative_target_rejected": true,
    "missing_target_argument_rejected": true,
    "target_symlinks_rejected": true,
    "canonical_target_binding": true,
    "public_control_root_override": false,
    "default_target": null,
    "max_backups": 10,
    "backup_managed_path_record_schema": "path-size-sha256",
    "new_target_mode": "0700",
    "preserve_existing_target_mode": true,
    "rollback_on_failure": true
  },
  "runtime_compatibility": {
    "baseline_ref": "references/qwen-code-baseline.json",
    "version_ref": "build/version.json",
    "tested_version": "0.21.6",
    "package": "@qwen-code/qwen-code",
    "release_tag": "v0.21.6",
    "documentation": [
      "docs/users/configuration/settings.md",
      "docs/users/features/approval-mode.md",
      "docs/users/features/hooks.md",
      "docs/users/features/mcp.md",
      "docs/users/features/memory.md",
      "docs/users/extension/introduction.md",
      "docs/users/features/skills.md",
      "docs/users/features/sub-agents.md"
    ]
  },
  "runtime_launch": {
    "command": "<absolute-target>/bin/qwen",
    "direct_command": "QWEN_HOME=<absolute-target> QWEN_RUNTIME_DIR=<absolute-target>/runtime <absolute-target>/bin/qwen [args...]",
    "home_environment_variable": "QWEN_HOME",
    "runtime_environment_variable": "QWEN_RUNTIME_DIR",
    "executable_source": "validated-target-owned-official-release-archive",
    "forwards_arguments": true,
    "forwards_child_exit_code": true,
    "json_manager_errors_supported": true,
    "manager_command": "python3 cli-tools/nddev_qwen_code.py launch --target <absolute-target> [--workspace <absolute-project-dir>] -- [args...]",
    "requires_clean_managed_target": true,
    "streams_child_stdio": true,
    "successful_child_output_wrapped": false,
    "environment_scope": "child-process-only",
    "launch_handoff": "private non-writable verified handoff image",
    "workspace_scope": {
      "manager_option": "--workspace <absolute-existing-directory>",
      "default": "captured caller cwd",
      "native_qwen_primary_workspace_flag": null,
      "child_cwd_explicit": true,
      "blocked_native_workspace_controls": [
        "--include-directories",
        "--add-dir",
        "--includeDirectories",
        "--addDir",
        "--worktree",
        "--workspace",
        "--cwd"
      ],
      "blocked_short_value_forms": ["-e", "-i", "-m", "-o", "-p", "-r"],
      "grammar_source_ref": "references/qwen-code-baseline.json:launch_scope_grammar"
    },
    "path_inherited": false,
    "target_must_equal_qwen_home": true
  },
  "software_install": {
    "tested_version": "0.21.6",
    "node_requires": ">=22.0.0",
    "supported_hosts": [
      "macos-arm64",
      "macos-x64",
      "ubuntu-glibc-arm64",
      "ubuntu-glibc-x64"
    ],
    "unsupported_categories": [
      "windows",
      "non-ubuntu-linux",
      "linux-musl",
      "unsupported-architecture"
    ],
    "ubuntu_version_floor": null,
    "vendor_platforms": ["darwin-arm64", "darwin-x64", "linux-arm64", "linux-x64"],
    "package_provenance": {
      "name": "@qwen-code/qwen-code",
      "tarball": "https://registry.npmjs.org/@qwen-code/qwen-code/-/qwen-code-0.21.6.tgz",
      "tarball_size_bytes": 24695893,
      "integrity": "sha512-sA5dcdH03ilVH5Ze/oREJHuUlYF9b2fn2rucWWqnvC5Q7i/t9iY0rSRe32UXZquPFuo9V2DVDodEOUFqChz9kA==",
      "shasum": "dfec831223258d34f9d4ceb88d959120dd792e9d",
      "scripts_enabled": false
    },
    "release_archive": {
      "base_url": "https://github.com/QwenLM/qwen-code/releases/download/v0.21.6",
      "verification": "pinned-size-sha256",
      "materialization": "manager-owned-safe-extract-no-scripts"
    },
    "preconditions": {
      "install": "absent target-owned Qwen Code software surface",
      "update": "installed or safe partial target-owned Qwen Code software surface",
      "partial_state_policy": "install rejects any replace path or owned software parent; update may repair safe partial state",
      "preflight": "existing replace paths and software parent directories are validated before archive download"
    },
    "bounds": {
      "max_tree_paths": 100000,
      "max_tree_bytes": 1073741824
    },
    "layout": {
      "visible_command": "bin/qwen",
      "entrypoint_resolution": "target-relative-wrapper",
      "install_root": "lib/qwen-code",
      "package_manifest": "lib/qwen-code/package.json",
      "software_manifest": "software/qwen-code.json",
      "runtime_dir": "runtime"
    },
    "commands": {
      "status": "python3 cli-tools/nddev_qwen_code.py software-status --target <absolute-target> [--json]",
      "install": "python3 cli-tools/nddev_qwen_code.py install-cli --target <absolute-target> [--json]",
      "update": "python3 cli-tools/nddev_qwen_code.py update-cli --target <absolute-target> [--json]",
      "remove": "python3 cli-tools/nddev_qwen_code.py remove-cli --target <absolute-target> [--json]"
    }
  },
  "builder_extension": {
    "projection": "qwen-extension",
    "source_root": "extensions/nddev-builder",
    "manifest": "extensions/nddev-builder/qwen-extension.json",
    "version_ref": "build/version.json:nddev_builder_extension_version",
    "native_paths": ["QWEN.md", "skills", "agents"],
    "skills": ["qwen-builder-orientation"],
    "agents": ["qwen-builder-reviewer"],
    "default_on": true,
    "marketplace_manifest": false
  }
}
